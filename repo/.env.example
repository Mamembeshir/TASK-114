# ── Meridian Portal build-time environment variables ──────────────────────────
#
# Copy to .env.local for local overrides. Never commit .env.local.
#
# VITE_SEED_DEMO
#   Controls whether the three demo staff accounts (admin / editor / reviewer)
#   are seeded into IndexedDB on first launch.
#
#   true  → seed demo accounts (default in dev mode — no flag needed)
#   false → skip seeding (use this for production / real deployments)
#
#   In development (pnpm dev), demo accounts are always seeded regardless of
#   this flag. Set to false only for production builds (pnpm build).
#
VITE_SEED_DEMO=false
