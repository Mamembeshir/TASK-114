# Dedicated image for CI test runs
FROM node:22-alpine

RUN npm install -g pnpm@10.23.0

WORKDIR /app

COPY package.json pnpm-lock.yaml* ./
# Increase timeout + retries for slow/throttled Docker build networks
RUN pnpm config set network-timeout 300000 && \
    pnpm config set fetch-retries 5 && \
    pnpm install --frozen-lockfile

COPY . .

# Default: run tests once (CI mode)
CMD ["pnpm", "test"]
