# Dedicated image for CI test runs
FROM node:20-slim

RUN npm install -g pnpm@10.23.0

WORKDIR /app

# Copy manifests + .npmrc first (layer caching)
COPY package.json pnpm-lock.yaml* .npmrc ./

RUN pnpm install

# Copy all source files
COPY . .

# Default: run tests once (CI mode)
CMD ["pnpm", "test"]
